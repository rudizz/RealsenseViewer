{
    "configurations": [
        {
            "name": "Windows",
            "includePath": [
                "${workspaceFolder}/include",
                "${env:OPENCV_DIR}/include",
                "C:/OpenCV/include",
                "C:/Program Files/PCL 1.15.1/include/pcl-1.15",
                "C:/Program Files/PCL 1.15.1/3rdParty/Eigen3/include/eigen3",
                "C:/Program Files (x86)/Intel RealSense SDK 2.0/include",
                "C:/Program Files/Intel RealSense SDK 2.0/include",
                "C:/Program Files/PCL*/include/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "windowsSdkVersion": "10.0",
            "compilerPath": "cl.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-msvc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        },
        {
            "name": "macOS",
            "includePath": [
                "${workspaceFolder}/include",
                "/opt/homebrew/include",
                "/opt/homebrew/include/opencv4",
                "/usr/local/include",
                "/usr/local/include/opencv4"
            ],
            "defines": [],
            "macFrameworkPath": [
                "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks"
            ],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ],
    "version": 4
}
